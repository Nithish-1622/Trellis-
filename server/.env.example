# Application Configuration
APP_NAME="Trellis Personalized Learning API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
PILOT_FEATURE_ENABLED=true

# API Settings
API_HOST="0.0.0.0"
API_PORT=8000

# Appwrite identity validation
APPWRITE_ENDPOINT="https://<REGION>.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="your_project_id"
APPWRITE_AUTH_TIMEOUT_SECONDS=5
ADMIN_USER_IDS=""

# Supplemental learning resources
YOUTUBE_API_KEY=""
GITHUB_TOKEN=""
PROVIDER_TIMEOUT_SECONDS=8
RESOURCE_VETTING_ENABLED=true
RESOURCE_VETTED_SCORE_THRESHOLD=80
RESOURCE_DISCOVERED_SCORE_THRESHOLD=60
RESOURCE_MIN_CONFIDENCE=0.45
RESOURCE_DISCOVERY_PROVIDER_LIMIT=10
RESOURCE_DISCOVERY_SKILL_LIMIT=12
YOUTUBE_MIN_DURATION_SECONDS=120
YOUTUBE_MAX_DURATION_SECONDS=14400

# Generic transcript HTTP adapter. Trellis calls GET with provider,
# external_id, and language query parameters and expects JSON containing
# available, language, and text. Text is analyzed in memory and not persisted.
TRANSCRIPT_API_URL=""
TRANSCRIPT_API_KEY=""
TRANSCRIPT_TIMEOUT_SECONDS=8
VETTING_TRANSCRIPT_MAX_CHARS=60000

# Durable PostgreSQL resource worker
RESOURCE_JOB_MAX_ATTEMPTS=3
RESOURCE_WORKER_POLL_SECONDS=2
RESOURCE_SCHEDULER_INTERVAL_SECONDS=60
RESOURCE_REEVALUATION_BATCH_SIZE=20
RESOURCE_INTERACTION_RETENTION_DAYS=90

# Google Gemini API
GOOGLE_API_KEY="_your_api_key_here_"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"

# JSearch API (RapidAPI) - Real Job Search
JSEARCH_API_KEY="_your_api_key_here_"
JSEARCH_API_HOST="jsearch.p.rapidapi.com"

# Groq API
GROQ_API_KEY="_your_api_key_here_"
GROQ_MODEL="openai/gpt-oss-120b"
ENABLE_AI_PROJECT_GRADING=false
ENABLE_AI_CHAT=false

# Database Configuration
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/career_mentor_db"

# LangSmith (Optional - for debugging)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="trellis"

# Memory & Vector Store
VECTOR_DIMENSION=768
MEMORY_SIMILARITY_THRESHOLD=0.7

# Agent Configuration
MAX_ITERATIONS=15
CHECKPOINT_ENABLED=True

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://trellis.saumyajit.dev"

# Logging
LOG_LEVEL="INFO"
